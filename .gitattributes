# Preservar exactamente los bytes de las fuentes al clonar en cualquier sistema.
Data_Raw/** -text
Diccionario/*.csv -text

# Código y documentación con finales de línea portables.
*.py text eol=lf
*.ipynb text eol=lf
*.md text eol=lf
*.MD text eol=lf
*.R text eol=lf
*.qmd text eol=lf
*.json text eol=lf
*.geojson text eol=lf
.Rprofile text eol=lf
renv.lock text eol=lf
renv/activate.R whitespace=-trailing-space
requirements*.txt text eol=lf
requirements*.in text eol=lf
